{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/writeDistPackage.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:infra": "vitest run test/infra --config vitest.infra.config.ts",
    "typecheck": "tsc --noEmit",
    "test:floci": "vitest run --config vitest.floci.config.ts",
    "test:floci:e2e": "vitest run --config vitest.floci-e2e.config.ts",
    "local:stack": "vite-node scripts/localStack.ts",
    "local:stop": "vite-node scripts/localStop.ts",
    "role": "vite-node scripts/setRole.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:performance:local": "vite-node scripts/performanceLocal.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1164.0",
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewayv2": "^3.1164.0",
    "@aws-sdk/client-cloudformation": "^3.1164.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1164.0",
    "@aws-sdk/client-iam": "^3.1164.0",
    "@aws-sdk/client-lambda": "^3.1164.0",
    "@types/node": "^22.13.0",
    "jszip": "^3.10.2",
    "playwright-core": "^1.65.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.5",
    "yaml": "^2.9.1"
  }
}
