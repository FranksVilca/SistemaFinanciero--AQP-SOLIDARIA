# AQP-SOLIDARIA · Arquitectura Zero Trust OBJETIVO (con las mejoras propuestas)
# Render:  d2 --layout=tala --pad 30 zta-architecture-target.d2 zta-architecture-target.png   (también .svg)
# ★ = mejora respecto a la arquitectura actual (zta-architecture.d2)
# Icono AWS = servicio de AWS · caja sin icono = código nuestro / proceso.

vars: {
  icons: https://icons.terrastruct.com/aws
}

direction: down

classes: {
  zone-red:   { style: { fill: "#FDEDEC"; stroke: "#C0392B"; stroke-width: 2; border-radius: 14; font-color: "#C0392B"; bold: true; font-size: 20 } }
  zone-grey:  { style: { fill: "#F3F4F6"; stroke: "#6B7280"; stroke-width: 2; border-radius: 14; font-color: "#4B5563"; bold: true; font-size: 20 } }
  zone-blue:  { style: { fill: "#EAF1FB"; stroke: "#1F5FBF"; stroke-width: 2; border-radius: 14; font-color: "#1F5FBF"; bold: true; font-size: 20 } }
  zone-orange:{ style: { fill: "#FEF5E7"; stroke: "#E67E22"; stroke-width: 2; border-radius: 14; font-color: "#B9600F"; bold: true; font-size: 20 } }
  zone-green: { style: { fill: "#EAF7EE"; stroke: "#1E8449"; stroke-width: 2; border-radius: 14; font-color: "#1E8449"; bold: true; font-size: 20 } }
  zone-purple:{ style: { fill: "#F4ECF7"; stroke: "#7D3C98"; stroke-width: 2; border-radius: 14; font-color: "#7D3C98"; bold: true; font-size: 20 } }
  svc:        { width: 90; height: 90; style: { font-size: 16 } }
  code:       { shape: rectangle; style: { fill: "#FFFFFF"; stroke: "#1E8449"; stroke-width: 2; stroke-dash: 4; border-radius: 10; font-size: 16 } }
  flow:       { style: { stroke-width: 3; font-size: 16 } }
  soft:       { style: { stroke-width: 2; stroke-dash: 5; font-size: 15; stroke: "#6B7280"; font-color: "#4B5563" } }
}

zona: "ZONA NO CONFIABLE · navegador del usuario (nunca se confía)" {
  class: zone-red
  users: "Visitante · Donante\nGestor · Auditor" { shape: person; style.font-size: 16 }
  spa: "SPA React\n(corre en el navegador)\ntokens solo en memoria" { shape: rectangle; style: { fill: "#FFFFFF"; stroke: "#C0392B"; stroke-width: 2; border-radius: 10; font-size: 16 } }
}

front: "ENTREGA DEL FRONTEND (solo archivos estáticos)" {
  class: zone-grey
  cf: "CloudFront + OAC\nHTTPS · CSP · HSTS" { class: svc; shape: image; icon: ${icons}/Networking%20%26%20Content%20Delivery/Amazon-CloudFront.svg }
  s3: "S3 privado\n(guarda la SPA compilada)" { class: svc; shape: image; icon: ${icons}/Storage/Amazon-Simple-Storage-Service-S3.svg }
}

pa: "PA · administrador de políticas (identidad)" {
  class: zone-blue
  cognito: "Amazon Cognito\n★ MFA TOTP OBLIGATORIO (todo el pool)\nPKCE · tokens de vida corta" { class: svc; shape: image; icon: ${icons}/Security%2C%20Identity%2C%20%26%20Compliance/Amazon-Cognito.svg }
}

pep: "PEP · punto de aplicación (verifica CADA solicitud)" {
  class: zone-orange
  apigw: "API Gateway (HTTP API)\nJWT authorizer + scopes\n★ throttling por ruta · ★ CORS solo dominio propio" { class: svc; shape: image; icon: ${icons}/Networking%20%26%20Content%20Delivery/Amazon-API-Gateway.svg }
}

back: "BACKEND · un solo código (backend/src) desplegado como 9 funciones" {
  class: zone-green
  lam: "9 funciones Lambda (una por endpoint)\nlist · get · stats · create · publish\ndonate · simulate · me · audit" { class: svc; shape: image; icon: ${icons}/Compute/AWS-Lambda.svg }
  authz: "★ withAuth(): envoltorio OBLIGATORIO\nPE: rol + propietario + estado · fail-closed\n★ audita también los DENEGADOS (401/403)\n★ acciones sensibles: revalida la sesión en Cognito\n(una prueba falla si una ruta no lo usa)" { class: code; style.stroke: "#1E8449"; style.stroke-width: 4 }
}

avp: "Verified Permissions (Cedar)\n★ fase 2: motor de políticas externo" {
  shape: rectangle
  style: { fill: "#F3F4F6"; stroke: "#6B7280"; stroke-width: 2; stroke-dash: 4; border-radius: 10; font-size: 16 }
}

datos: "DATOS DE NEGOCIO · acceso mínimo" {
  class: zone-green
  role: "★ Roles IAM mínimos por función\n(solo las acciones necesarias:\nsin borrar, sin comodines)" { class: svc; shape: image; icon: ./icons/iam-role.png }
  ddb: "DynamoDB\nProjects · Donations · Idempotency\n★ recuperación PITR + protección contra borrado" { class: svc; shape: image; icon: ${icons}/Database/Amazon-DynamoDB.svg }
}

audit: "★ AUDITORÍA · frontera propia (append-only)" {
  class: zone-purple
  audb: "DynamoDB · tabla Audit\n★ solo PutItem (sin editar ni borrar)\n★ actor pseudonimizado · éxitos y denegados" { class: svc; shape: image; icon: ${icons}/Database/Amazon-DynamoDB.svg }
}

tel: "TELEMETRÍA · ★ definida en el IaC" {
  class: zone-grey
  cw: "CloudWatch Logs\nJSON + requestId\n★ retención 14 días en el template" { class: svc; shape: image; icon: ${icons}/Management%20%26%20Governance/Amazon-CloudWatch.svg }
  ct: "CloudTrail\n★ definido en el template" { class: svc; shape: image; icon: ${icons}/Management%20%26%20Governance/AWS-CloudTrail.svg }
  gd: "GuardDuty · Security Hub\n★ opcionales: prueba de 30 días\n(parámetros apagados por defecto)" { shape: rectangle; style: { fill: "#FFFFFF"; stroke: "#6B7280"; stroke-width: 2; stroke-dash: 4; border-radius: 10; font-size: 16 } }
}

ci: "★ CI (GitHub Actions)\ntests de integración con DynamoDB emulado\nmatriz de roles + BOLA + idempotencia\ncfn-lint / checkov sobre el template" {
  shape: rectangle
  style: { fill: "#FFFFFF"; stroke: "#1E8449"; stroke-width: 4; border-radius: 10; font-size: 16 }
}

deploy: "Despliegue SAM / IAM\n(cambios en la cuenta AWS)" { class: svc; shape: image; icon: ${icons}/Management%20%26%20Governance/AWS-CloudFormation.svg }

leyenda: |md
  **LEYENDA**

  icono AWS = servicio de AWS

  caja sin icono = código nuestro / proceso

  ★ = mejora respecto a la arquitectura actual
| { style: { fill: "#FFFBEA"; stroke: "#6B7280"; border-radius: 10; font-size: 15 } }

# ---- Flujos ----
zona.users -> front.cf: "HTTPS" { class: soft }
front.cf -> front.s3: "lee" { class: soft }
front.cf -> zona.spa: "descarga el código de la SPA" { class: soft }

zona.spa <-> pa.cognito: "① login: Auth Code + PKCE + MFA\n② devuelve access token" { class: flow; style.stroke: "#1F5FBF" }
zona.spa -> pep.apigw: "③ Authorization: Bearer <token>" { class: flow; style.stroke: "#E67E22" }
pa.cognito -> pep.apigw: "validación local\n(firma · issuer · aud · scopes)" { class: soft; style.stroke: "#1F5FBF" }

pep.apigw -> back.lam: "④ claims ya verificados\n(sub · grupo · scopes)" { class: flow; style.stroke: "#E67E22" }
back.lam -> back.authz: "⑤ withAuth() antes de actuar" { class: flow; style.stroke: "#1E8449" }
back.authz -> avp: "fase 2" { class: soft }

back.lam -> datos.role: "⑥ cada función usa solo su rol" { class: flow; style.stroke: "#1E8449" }
datos.role -> datos.ddb { class: flow; style.stroke: "#1E8449" }
back.authz -> audit.audb: "★ ⑦ evento de auditoría\n(solo PutItem)" { class: flow; style.stroke: "#7D3C98" }

back.lam -> tel.cw: "⑧ logs de todas las funciones" { class: soft }
pep.apigw -> tel.cw: "logs de acceso" { class: soft }
ci -> deploy: "★ solo despliega si pasa" { class: flow; style.stroke: "#1E8449" }
deploy -> tel.ct: "registra quién cambió qué" { class: soft }
