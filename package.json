{
  "name": "secure-donations-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de Donaciones Seguras Zero Trust - Fundación AQP-SOLIDARIA",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=backend && npm run typecheck --workspace=frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "npm run test:integration --workspace=backend",
    "test:infra": "npm run test:infra --workspace=backend",
    "test:floci": "npm run test:floci --workspace=backend",
    "test:floci:e2e": "npm run test:floci:e2e --workspace=backend",
    "local": "npm run local:stack --workspace=backend",
    "local:stop": "npm run local:stop --workspace=backend",
    "role": "npm run role --workspace=backend --",
    "local:trust": "certutil -user -addstore Root .local/floci-root-ca.crt",
    "test:browser": "npm run test:browser --workspace=backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0"
  }
}
